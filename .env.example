# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: register the slash commands in this guild only (instant updates and
# a hard restriction on where the bot accepts commands). Leave empty to publish
# the commands globally (can take up to an hour to appear).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Crafty Controller (remote, reached over HTTPS)
# ---------------------------------------------------------------------------
# Base URL of the remote Crafty instance -- no trailing path.
#   Public reverse proxy:  https://crafty.example.com
#   Direct HTTPS port:     https://crafty.example.com:8443
#   Tailscale/VPN address: https://100.101.102.103:8443
CRAFTY_URL=
# API key created in Crafty: Panel -> Users -> (your user) -> API Keys.
CRAFTY_API_TOKEN=
# Set to false ONLY when Crafty uses a self-signed certificate on a private
# network. Prefer a trusted certificate.
CRAFTY_VERIFY_SSL=true
# Per-request timeout in seconds.
CRAFTY_TIMEOUT=10
# Default server used when a command omits the `server` option. Optional when
# the API key can only see one server.
CRAFTY_SERVER_ID=
# UTC offset in hours of the machine running Crafty, e.g. 2 for CEST, -5 for
# EST, 5.5 for IST. Crafty reports naive local timestamps, so set this when the
# Pi and the Crafty host are in different time zones -- otherwise uptimes are
# wrong by exactly the difference. Leave empty when both share a time zone.
CRAFTY_UTC_OFFSET=

# ---------------------------------------------------------------------------
# Azure (the VM that hosts Crafty). Leave empty to disable /azure commands.
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_VM_NAME=
# Service principal. Also read by DefaultAzureCredential; required when
# azure-identity is not installed.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TIMEOUT=30

# ---------------------------------------------------------------------------
# Discord permissions (comma or space separated IDs)
# ---------------------------------------------------------------------------
# Administrators: everything, including forced shutdowns and /server kill.
# Members with Discord's Administrator permission and the guild owner always
# count as administrators.
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
# May start/stop/restart Minecraft, run console commands, read logs, back up.
SERVER_CONTROL_ROLE_IDS=
# May start/stop/deallocate the Azure VM.
AZURE_CONTROL_ROLE_IDS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Deallocate the VM after Minecraft stops (saves Azure compute cost).
AUTO_SHUTDOWN_VM=false
# Grace period in seconds between "Minecraft stopped" and "VM deallocated".
AUTO_SHUTDOWN_DELAY=300

# Inactivity auto-shutdown (the /timeout switch).
#
# Setting this to true pre-arms /timeout for the default server at startup, so
# an empty server is stopped gracefully through Crafty and -- when
# AUTO_SHUTDOWN_VM is on -- the VM is deallocated afterwards. Whether or not it
# is enabled here, anyone with the server role can arm or cancel the same switch
# at runtime with /timeout, or with the button under /status.
IDLE_SHUTDOWN_ENABLED=false
# Idle minutes for the pre-armed timeout, and the value pre-filled in the
# /status dialog.
IDLE_SHUTDOWN_MINUTES=30
# Seconds between player-count checks while a timeout is armed. No calls are
# made at all while nothing is armed. (The old name IDLE_CHECK_INTERVAL is still
# read when this one is unset.)
TIMEOUT_CHECK_INTERVAL=60
# Where armed timeouts are remembered across restarts, so a restart cannot leave
# a VM billing overnight. Must be writable by the bot's user; set it to empty to
# disable persistence entirely.
TIMEOUT_STATE_FILE=timeout_state.json

# How long a status reading may be reused (seconds). Keep this small.
STATUS_CACHE_TTL=10
# Upper bounds for the start/stop workflows (seconds).
START_TIMEOUT=600
STOP_TIMEOUT=300

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
